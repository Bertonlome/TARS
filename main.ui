                                 </property>
                                 <property name="styleSheet">
                                  <string notr="true">QPushButton {
        border: 2px solid rgba(221, 0, 20, 255);
        border-radius: 5px;
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 rgba(33, 37, 43, 255), stop:1 rgba(40,40,50,255));
        font: 600 16pt &quot;JetBrains Mono&quot;;
        padding: 6px 10px;
    }
    QPushButton:pressed {
        /* darker, slightly inset 3D pressed look */
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 rgba(221, 0, 20, 255), stop:1 rgba(230,0,30,255));
        border: 2px solid rgba(221, 0, 20, 255);
        padding-top: 8px;    /* push content down to simulate depression */
        padding-bottom: 4px;
    }
    QPushButton:focus {
        outline: none;
    }</string>
                                 </property>
                                 <property name="text">
                                  <string>CANCEL EXECUTION</string>
                                 </property>
                                 <property name="icon">
                                  <iconset resource="resources.qrc">
                                   <normaloff>:/icons/images/icons/alarm-noack-iec.svg</normaloff>:/icons/images/icons/alarm-noack-iec.svg</iconset>
                                 </property>
                                </widget>
