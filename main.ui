                                 <property name="styleSheet">
                                  <string notr="true">QPushButton {
        border: 2px solid rgba(221, 221, 221, 255);
        border-radius: 5px;
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 rgba(245,245,245,255), stop:1 rgba(221,221,221,255));
        font: 600 16pt &quot;JetBrains Mono&quot;;
        color: rgba(33, 37, 43, 255);
        padding: 6px 10px;
    }
    QPushButton:pressed {
        /* darker, slightly inset 3D pressed look */
        background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
            stop:0 rgba(190,190,190,255), stop:1 rgba(150,150,150,255));
        border: 2px solid rgba(140,140,140,255);
        padding-top: 8px;    /* push content down to simulate depression */
        padding-bottom: 4px;
        color: rgba(20, 24, 28, 255);
    }
    QPushButton:focus {
        outline: none;
    }</string>
