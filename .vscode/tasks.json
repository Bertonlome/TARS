{
    // See https://code.visualstudio.com/docs/editor/tasks for more information
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate UI Python from main.ui",
            "type": "shell",
            "command": "pyside6-uic main.ui -o modules/ui_main.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Generate python resource file from resources.qrc",
            "type": "shell",
            "command": "pyside6-rcc resources.qrc -o modules/resources_rc.py",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}